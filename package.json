{
  "name": "nocterra",
  "version": "1.0.1",
  "description": "NOCTERRA \u2014 Minecraft Bedrock subculture gacha action RPG",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node tools/build.mjs",
    "validate": "node tools/validate.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && node tools/audit-api.mjs && npm run validate && node tools/qa-rig.mjs && npm test && npm run build",
    "package": "node tools/build.mjs --package",
    "preview": "node tools/render-preview.mjs",
    "package:android": "npm run build && node tools/package-android.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choivoo/NocTera.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/choivoo/NocTera/issues"
  },
  "homepage": "https://github.com/choivoo/NocTera#readme",
  "devDependencies": {
    "@minecraft/server": "^2.10.0",
    "@minecraft/server-ui": "^2.2.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
